<?xml version="1.0" encoding="utf-8"?>
<!--
  vmouse.vcxproj  -  Visual Studio + WDK KMDF 드라이버 프로젝트

  빌드:
    msbuild vmouse.vcxproj /p:Configuration=Release /p:Platform=x64
    결과물: x64\Release\vmouse.sys, vmouse.inf

  WDKContentRoot 값에 따라 두 가지 WDK 구조 모두 지원:
    구버전 (≤22621): WDKContentRoot = KitsRoot10\  (props = $(WDKContentRoot)build\*.props)
    신버전 (≥26100): WDKContentRoot = KitsRoot10\build\VERSION\  (props = $(WDKContentRoot)*.props)
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <TemplateGuid>{B12F7EF9-1B14-4EC1-8993-15DE4A30D89A}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <ProjectName>vmouse</ProjectName>
    <TargetOsVersion>10.0</TargetOsVersion>
    <TargetPlatformVersion>10.0</TargetPlatformVersion>
  </PropertyGroup>

  <!-- ── WindowsDriver.Default.props ─────────────────────────────────────── -->
  <!-- 신버전: WDKContentRoot = .../build/VERSION/  → 직접 임포트 -->
  <Import Project="$(WDKContentRoot)WindowsDriver.Default.props"
          Condition="Exists('$(WDKContentRoot)WindowsDriver.Default.props')" />
  <!-- 구버전: WDKContentRoot = KitsRoot/  → build\ 하위 임포트 -->
  <Import Project="$(WDKContentRoot)build\WindowsDriver.Default.props"
          Condition="!Exists('$(WDKContentRoot)WindowsDriver.Default.props') And
                     Exists('$(WDKContentRoot)build\WindowsDriver.Default.props')" />

  <PropertyGroup Label="Configuration"
                 Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <WdfVersionMajor>1</WdfVersionMajor>
    <WdfVersionMinor>15</WdfVersionMinor>
  </PropertyGroup>

  <!-- ── WindowsDriver.props ──────────────────────────────────────────────── -->
  <!-- 신버전: 버전 폴더 직접 -->
  <Import Project="$(WDKContentRoot)WindowsDriver.props"
          Condition="Exists('$(WDKContentRoot)WindowsDriver.props')" />
  <!-- 신버전 폴백: 버전 폴더의 상위(build\) -->
  <Import Project="$(WDKContentRoot)..\WindowsDriver.props"
          Condition="!Exists('$(WDKContentRoot)WindowsDriver.props') And
                     Exists('$(WDKContentRoot)..\WindowsDriver.props')" />
  <!-- 구버전 -->
  <Import Project="$(WDKContentRoot)build\WindowsDriver.props"
          Condition="!Exists('$(WDKContentRoot)WindowsDriver.props') And
                     !Exists('$(WDKContentRoot)..\WindowsDriver.props') And
                     Exists('$(WDKContentRoot)build\WindowsDriver.props')" />

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>vhfkm.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EntryPointSymbol>DriverEntry</EntryPointSymbol>
    </Link>
    <Inf>
      <TimeStamp>10/16/2026 00:00:00</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="vmouse.c" />
    <Inf Include="vmouse.inf" />
  </ItemGroup>

  <!-- ── WindowsDriver.targets ────────────────────────────────────────────── -->
  <!-- 신버전: 버전 폴더 직접 -->
  <Import Project="$(WDKContentRoot)WindowsDriver.targets"
          Condition="Exists('$(WDKContentRoot)WindowsDriver.targets')" />
  <!-- 신버전 폴백: 버전 폴더의 상위(build\) -->
  <Import Project="$(WDKContentRoot)..\WindowsDriver.targets"
          Condition="!Exists('$(WDKContentRoot)WindowsDriver.targets') And
                     Exists('$(WDKContentRoot)..\WindowsDriver.targets')" />
  <!-- 구버전 -->
  <Import Project="$(WDKContentRoot)build\WindowsDriver.targets"
          Condition="!Exists('$(WDKContentRoot)WindowsDriver.targets') And
                     !Exists('$(WDKContentRoot)..\WindowsDriver.targets') And
                     Exists('$(WDKContentRoot)build\WindowsDriver.targets')" />

</Project>
