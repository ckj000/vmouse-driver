<?xml version="1.0" encoding="utf-8"?>
<!--
  vmouse.vcxproj  -  v143 MSVC + 커널 모드 플래그 (WDK 설치 불필요)

  빌드:
    msbuild vmouse.vcxproj /p:Configuration=Release /p:Platform=x64
    결과물: x64\Release\vmouse.sys

  WDKContentRoot 가 설정돼 있으면 그 경로에서 KitsRoot10 / WdkVersion / KmdfVersion
  을 자동 추출합니다.
  예) WDKContentRoot = C:\...\10\build\10.0.28000.0\
      → KitsRoot10   = C:\...\10\
      → WdkVersion   = 10.0.28000.0
      → KmdfVersion  = 1.33 (폴더 자동 탐색)
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <ProjectName>vmouse</ProjectName>

    <!--
      WDKContentRoot (예: C:\...\10\build\10.0.28000.0\) 에서
      KitsRoot10 과 WdkVersion 추출
    -->
    <_WdkTrimmed>$(WDKContentRoot.TrimEnd('\'))</_WdkTrimmed>
    <WdkVersion Condition="'$(WdkVersion)' == '' And '$(WDKContentRoot)' != ''">$([System.IO.Path]::GetFileName('$(_WdkTrimmed)'))</WdkVersion>
    <KitsRoot10 Condition="'$(KitsRoot10)' == '' And '$(WDKContentRoot)' != ''">$([System.IO.Directory]::GetParent($([System.IO.Directory]::GetParent('$(_WdkTrimmed)').FullName)).FullName)\</KitsRoot10>

    <!-- KMDF 버전: 최신→구 순으로 탐색 -->
    <KmdfVersion Condition="'$(KmdfVersion)' == '' And Exists('$(KitsRoot10)Include\wdf\kmdf\1.33')">1.33</KmdfVersion>
    <KmdfVersion Condition="'$(KmdfVersion)' == '' And Exists('$(KitsRoot10)Include\wdf\kmdf\1.31')">1.31</KmdfVersion>
    <KmdfVersion Condition="'$(KmdfVersion)' == '' And Exists('$(KitsRoot10)Include\wdf\kmdf\1.29')">1.29</KmdfVersion>
    <KmdfVersion Condition="'$(KmdfVersion)' == '' And Exists('$(KitsRoot10)Include\wdf\kmdf\1.15')">1.15</KmdfVersion>
    <KmdfVersion Condition="'$(KmdfVersion)' == ''">1.33</KmdfVersion>
  </PropertyGroup>

  <!-- 표준 MSVC 툴셋 props (Build 타깃 정의됨) -->
  <Import Project="$(VCTargetsPath)Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <!-- v143 = VS2022 MSVC. WindowsKernelModeDriver 툴셋 불필요 -->
    <PlatformToolset>v143</PlatformToolset>
    <!-- Application: /DLL 없이 빌드, TargetExt=.sys 로 커널 드라이버 생성 -->
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>NotSet</CharacterSet>
    <TargetExt>.sys</TargetExt>
    <OutDir>$(MSBuildProjectDirectory)\x64\Release\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\x64\Release\obj\</IntDir>
    <TargetName>vmouse</TargetName>
    <!-- 커널 드라이버: Win32 매니페스트 비활성화 (LNK1295 /MANIFEST:EMBED 방지) -->
    <EmbedManifest>false</EmbedManifest>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)Microsoft.Cpp.props" />

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <!-- 커널 모드 전처리기 -->
      <PreprocessorDefinitions>
        _AMD64_;AMD64;_WIN64;NDEBUG;
        KMDF_VERSION_MAJOR=1;KMDF_VERSION_MINOR=15;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <!-- WDK 헤더 경로 -->
      <AdditionalIncludeDirectories>
        $(KitsRoot10)Include\$(WdkVersion)\km;
        $(KitsRoot10)Include\$(WdkVersion)\shared;
        $(KitsRoot10)Include\$(WdkVersion)\um;
        $(KitsRoot10)Include\wdf\kmdf\$(KmdfVersion);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <!-- 커널 모드 컴파일러 플래그 -->
      <AdditionalOptions>/kernel /GS- /Gs32768 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
    <Link>
      <!-- v143 toolset: /DRIVER /SUBSYSTEM:NATIVE /ENTRY:DriverEntry 명시적 지정 -->
      <!-- /MANIFEST:NO: 커널 드라이버는 Win32 매니페스트 없음 (LNK1295 방지) -->
      <AdditionalOptions>/DRIVER /SUBSYSTEM:NATIVE /ENTRY:DriverEntry /NODEFAULTLIB /MANIFEST:NO %(AdditionalOptions)</AdditionalOptions>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
      <GenerateManifest>false</GenerateManifest>
      <!-- 커널 모드 라이브러리
           WdfLdr.lib: KMDF 함수 테이블 스텁 (wdf\kmdf\x64\KmdfVersion\)
           vhfkm.lib : VHF 가상 HID 프레임워크 (km\x64\) -->
      <AdditionalDependencies>
        ntoskrnl.lib;hal.lib;vhfkm.lib;WdfLdr.lib;bufferoverflowk.lib;%(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalLibraryDirectories>
        $(KitsRoot10)Lib\$(WdkVersion)\km\x64;
        $(KitsRoot10)Lib\wdf\kmdf\x64\$(KmdfVersion);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="vmouse.c" />
  </ItemGroup>

  <!-- 표준 MSVC targets: Build 타깃 정의됨 -->
  <Import Project="$(VCTargetsPath)Microsoft.Cpp.targets" />

</Project>
